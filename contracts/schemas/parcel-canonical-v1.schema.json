{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://campus.yellowpeachxgp.com/schemas/parcel-canonical-v1.schema.json",
  "title": "Parcel Hub Canonical Parcel & Multi-Source Observation Schema (v1)",
  "description": "Defines the canonical parcel entity, multi-source provenance observations, pickup code confidence, and privacy settings.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "parcel_id",
    "campus_profile_id",
    "tracking",
    "status",
    "status_source",
    "source_observations",
    "privacy",
    "sync"
  ],
  "properties": {
    "parcel_id": { "type": "string", "format": "uuid" },
    "campus_profile_id": { "type": "string", "minLength": 1 },
    "tracking": {
      "type": "object",
      "additionalProperties": false,
      "required": ["carrier_code", "number", "verified"],
      "properties": {
        "carrier_code": { "type": "string", "minLength": 2, "maxLength": 32 },
        "carrier_name": { "type": "string" },
        "number": { "type": "string", "minLength": 4, "maxLength": 64 },
        "verified": { "type": "boolean" }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "UNSHIPPED",
        "IN_TRANSIT",
        "OUT_FOR_DELIVERY",
        "READY_FOR_PICKUP",
        "PICKED_UP",
        "EXCEPTION",
        "ARCHIVED"
      ]
    },
    "status_source": { "type": "string" },
    "source_observations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "observed_at"],
        "properties": {
          "source": {
            "type": "string",
            "enum": [
              "parcel.xiaomi.personal-assistant",
              "parcel.jd.orders",
              "parcel.taobao.cainiao",
              "parcel.pdd.orders",
              "parcel.kd100",
              "parcel.campus-station",
              "parcel.manual",
              "parcel.notification-parser"
            ]
          },
          "source_account_ref": { "type": ["string", "null"] },
          "observed_at": { "type": "string", "format": "date-time" },
          "confidence": {
            "type": "string",
            "enum": ["USER_CONFIRMED", "OFFICIAL_CARRIER", "SOURCE_REPORTED", "HEURISTIC"]
          }
        }
      }
    },
    "pickup": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["code", "confidence"],
      "properties": {
        "code": { "type": "string" },
        "station_id": { "type": ["string", "null"] },
        "station_name": { "type": ["string", "null"] },
        "shelf_label": { "type": ["string", "null"] },
        "confidence": {
          "type": "string",
          "enum": ["USER_CONFIRMED", "SOURCE_REPORTED", "SMS_PARSED"]
        }
      }
    },
    "product": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string" },
        "quantity": { "type": "integer", "minimum": 1 },
        "source_provider": { "type": "string" }
      }
    },
    "eta": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["basis"],
      "properties": {
        "expected_date": { "type": ["string", "null"] },
        "progress_pct": { "type": "integer", "minimum": 0, "maximum": 100 },
        "basis": { "type": "string", "enum": ["OFFICIAL_CARRIER", "RULE_BASED", "AI_ESTIMATED"] }
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["show_product_name", "show_code_on_lockscreen"],
      "properties": {
        "show_product_name": { "type": "boolean" },
        "show_code_on_lockscreen": { "type": "boolean" }
      }
    },
    "sync": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "last_success_at"],
      "properties": {
        "state": { "type": "string", "enum": ["FRESH", "STALE", "CONFLICT_PENDING"] },
        "last_success_at": { "type": "string", "format": "date-time" }
      }
    }
  }
}
