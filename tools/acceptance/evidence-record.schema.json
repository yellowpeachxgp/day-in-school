{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/yellowpeachxgp/day-in-school/schemas/cis-acceptance-evidence-v1.schema.json",
  "title": "CIS Acceptance Evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "recordId",
    "recordedAt",
    "itemId",
    "matrixVersion",
    "evidenceType",
    "verificationLevel",
    "acceptanceOutcome",
    "command",
    "exitCode",
    "sha",
    "execution",
    "deviceTestedPendingUser",
    "notes"
  ],
  "$defs": {
    "publicString": {
      "type": "string",
      "allOf": [
        {
          "not": {
            "pattern": "(?:^|[^0-9.])(?:[0-9]{1,3}[.]){3}[0-9]{1,3}(?:[^0-9.]|$)"
          }
        },
        {
          "not": {
            "pattern": "[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+"
          }
        },
        {
          "not": {
            "pattern": "PRIVATE KEY-----"
          }
        },
        {
          "not": {
            "pattern": "(ghp_[A-Za-z0-9_]{20,}|github_pat_[A-Za-z0-9_]{20,}|sk-[A-Za-z0-9_-]{20,}|AKIA[0-9A-Z]{16})"
          }
        },
        {
          "not": {
            "pattern": "/srv/"
          }
        },
        {
          "not": {
            "pattern": "/Volumes/"
          }
        }
      ]
    },
    "publicLogPath": {
      "allOf": [
        {
          "$ref": "#/$defs/publicString"
        },
        {
          "type": "string",
          "pattern": "^(<campus-root>/logs/|campus://logs/).+"
        }
      ]
    }
  },
  "properties": {
    "schemaVersion": {
      "const": "cis-acceptance-evidence/v1"
    },
    "recordId": {
      "type": "string",
      "format": "uuid"
    },
    "recordedAt": {
      "type": "string",
      "format": "date-time"
    },
    "itemId": {
      "type": "string",
      "pattern": "^(R0-[1-7]|C(0[1-9]|1[0-9]|2[0-8]))$"
    },
    "matrixVersion": {
      "const": "cis-acceptance-matrix/v1"
    },
    "evidenceType": {
      "enum": [
        "devbox-command-log",
        "unit-test-report",
        "integration-test-report",
        "android-lint-report",
        "android-apk-artifact",
        "roborazzi-report",
        "architecture-guard-report",
        "room-migration-report",
        "cloud-test-report",
        "contract-parity-report",
        "sql-migration-report",
        "github-ci-run",
        "secrets-scan-report",
        "backup-restore-report",
        "privacy-erasure-report",
        "plugin-installation-report",
        "screenshot-or-recording",
        "manual-device-note",
        "source-audit-note",
        "static-analysis-report"
      ]
    },
    "verificationLevel": {
      "enum": [
        "SOURCE_CONFIRMED",
        "MOCK_TESTED",
        "DEVICE_TESTED",
        "SCHOOL_VERIFIED",
        "DISTRIBUTION_READY"
      ]
    },
    "acceptanceOutcome": {
      "enum": [
        "pass",
        "fail",
        "not-run",
        "blocked",
        "device-pending-user"
      ]
    },
    "command": {
      "anyOf": [
        {
          "$ref": "#/$defs/publicString"
        },
        {
          "type": "null"
        }
      ]
    },
    "exitCode": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        {
          "type": "null"
        }
      ]
    },
    "sha": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "android",
        "cloud"
      ],
      "properties": {
        "android": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "cloud": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "anyOf": [
        {
          "required": [
            "android"
          ],
          "properties": {
            "android": {
              "type": "string"
            }
          }
        },
        {
          "required": [
            "cloud"
          ],
          "properties": {
            "cloud": {
              "type": "string"
            }
          }
        }
      ]
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "executedOn",
        "executor",
        "startedAt",
        "finishedAt",
        "durationMs",
        "logPath",
        "testName",
        "artifactPaths"
      ],
      "properties": {
        "executedOn": {
          "enum": [
            "devbox",
            "github-ci",
            "user-device",
            "school-account",
            "local-static"
          ]
        },
        "executor": {
          "$ref": "#/$defs/publicString"
        },
        "startedAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "finishedAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "durationMs": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "logPath": {
          "anyOf": [
            {
              "$ref": "#/$defs/publicLogPath"
            },
            {
              "type": "null"
            }
          ]
        },
        "testName": {
          "anyOf": [
            {
              "$ref": "#/$defs/publicString"
            },
            {
              "type": "null"
            }
          ]
        },
        "artifactPaths": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/publicString"
          },
          "uniqueItems": true
        }
      }
    },
    "deviceTestedPendingUser": {
      "type": "boolean"
    },
    "notes": {
      "anyOf": [
        {
          "$ref": "#/$defs/publicString"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "evidenceType": {
            "const": "devbox-command-log"
          }
        }
      },
      "then": {
        "properties": {
          "command": {
            "type": "string"
          },
          "exitCode": {
            "type": "integer"
          },
          "execution": {
            "properties": {
              "executedOn": {
                "const": "devbox"
              },
              "logPath": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "evidenceType": {
            "const": "github-ci-run"
          }
        }
      },
      "then": {
        "properties": {
          "execution": {
            "properties": {
              "executedOn": {
                "const": "github-ci"
              }
            }
          }
        },
        "anyOf": [
          {
            "properties": {
              "execution": {
                "properties": {
                  "artifactPaths": {
                    "minItems": 1
                  }
                }
              }
            }
          },
          {
            "properties": {
              "execution": {
                "properties": {
                  "testName": {
                    "type": "string"
                  }
                }
              }
            }
          },
          {
            "properties": {
              "notes": {
                "type": "string"
              }
            }
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "evidenceType": {
            "const": "manual-device-note"
          }
        }
      },
      "then": {
        "properties": {
          "execution": {
            "properties": {
              "executedOn": {
                "const": "user-device"
              }
            }
          }
        },
        "anyOf": [
          {
            "properties": {
              "execution": {
                "properties": {
                  "artifactPaths": {
                    "minItems": 1
                  }
                }
              }
            }
          },
          {
            "properties": {
              "execution": {
                "properties": {
                  "testName": {
                    "type": "string"
                  }
                }
              }
            }
          },
          {
            "properties": {
              "notes": {
                "type": "string"
              }
            }
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "evidenceType": {
            "const": "screenshot-or-recording"
          }
        }
      },
      "then": {
        "properties": {
          "execution": {
            "properties": {
              "artifactPaths": {
                "minItems": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "evidenceType": {
            "const": "source-audit-note"
          }
        }
      },
      "then": {
        "properties": {
          "execution": {
            "properties": {
              "executedOn": {
                "enum": [
                  "devbox",
                  "local-static"
                ]
              }
            }
          }
        },
        "anyOf": [
          {
            "properties": {
              "execution": {
                "properties": {
                  "testName": {
                    "type": "string"
                  }
                }
              }
            }
          },
          {
            "properties": {
              "notes": {
                "type": "string"
              }
            }
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "deviceTestedPendingUser": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "acceptanceOutcome": {
            "not": {
              "const": "pass"
            }
          }
        }
      }
    }
  ]
}
