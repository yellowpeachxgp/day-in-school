{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/yellowpeachxgp/day-in-school/schemas/cis-acceptance-matrix-v1.schema.json",
  "title": "CIS Acceptance Matrix v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "matrixId",
    "updatedAt",
    "source",
    "reusedDomainTypes",
    "verificationRules",
    "evidenceTypes",
    "privacyFlags",
    "migrationTypes",
    "acceptanceOutcomes",
    "zeroToleranceRules",
    "items"
  ],
  "properties": {
    "schemaVersion": {
      "const": "cis-acceptance-matrix/v1"
    },
    "matrixId": {
      "type": "string",
      "minLength": 1
    },
    "updatedAt": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "masterPlanPathAfterInf01",
        "masterPlanVersion",
        "sections",
        "bootstrapNote"
      ],
      "properties": {
        "masterPlanPathAfterInf01": {
          "type": "string"
        },
        "masterPlanVersion": {
          "type": "string"
        },
        "sections": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "bootstrapNote": {
          "type": "string"
        }
      }
    },
    "reusedDomainTypes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verificationLevel",
        "capabilityState",
        "dataProvenance",
        "schoolAccountScope"
      ],
      "properties": {
        "verificationLevel": {
          "type": "string"
        },
        "capabilityState": {
          "type": "string"
        },
        "dataProvenance": {
          "type": "string"
        },
        "schoolAccountScope": {
          "type": "string"
        }
      }
    },
    "verificationRules": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verificationLevels",
        "automaticEvidenceMaximumLevel",
        "deviceTestedPendingUserLabel",
        "rules"
      ],
      "properties": {
        "verificationLevels": {
          "type": "array",
          "items": {
            "enum": [
              "SOURCE_CONFIRMED",
              "MOCK_TESTED",
              "DEVICE_TESTED",
              "SCHOOL_VERIFIED",
              "DISTRIBUTION_READY"
            ]
          },
          "minItems": 5,
          "uniqueItems": true
        },
        "automaticEvidenceMaximumLevel": {
          "enum": [
            "SOURCE_CONFIRMED",
            "MOCK_TESTED"
          ]
        },
        "deviceTestedPendingUserLabel": {
          "const": "DEVICE_TESTED 待用户"
        },
        "rules": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        }
      }
    },
    "evidenceTypes": {
      "type": "array",
      "items": {
        "enum": [
          "devbox-command-log",
          "unit-test-report",
          "integration-test-report",
          "android-lint-report",
          "android-apk-artifact",
          "roborazzi-report",
          "architecture-guard-report",
          "room-migration-report",
          "cloud-test-report",
          "contract-parity-report",
          "sql-migration-report",
          "github-ci-run",
          "secrets-scan-report",
          "backup-restore-report",
          "privacy-erasure-report",
          "plugin-installation-report",
          "screenshot-or-recording",
          "manual-device-note",
          "source-audit-note",
          "static-analysis-report"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "privacyFlags": {
      "type": "array",
      "items": {
        "enum": [
          "profile-scoped-data",
          "user-content",
          "credentials-or-tokens",
          "ai-key",
          "location-data",
          "community-or-group-data",
          "payment-adjacent-data",
          "sensitive-files",
          "cloud-transit",
          "multi-profile-isolation"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "migrationTypes": {
      "type": "array",
      "items": {
        "enum": [
          "room",
          "cloud-sql",
          "backup-format",
          "datapack-format",
          "plugin-package-format"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "acceptanceOutcomes": {
      "type": "array",
      "items": {
        "enum": [
          "pass",
          "fail",
          "not-run",
          "blocked",
          "device-pending-user"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "zeroToleranceRules": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "items": {
      "type": "array",
      "minItems": 35,
      "maxItems": 35,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "title",
          "acceptanceSummary",
          "sourceRefs",
          "requiredEvidenceTypes",
          "privacy",
          "migration",
          "deviceTested",
          "maximumAutomaticVerificationLevel"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^(R0-[1-7]|C(0[1-9]|1[0-9]|2[0-8]))$"
          },
          "kind": {
            "enum": [
              "full-regression",
              "capability"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "acceptanceSummary": {
            "type": "string",
            "minLength": 1
          },
          "sourceRefs": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "requiredEvidenceTypes": {
            "type": "array",
            "items": {
              "enum": [
                "devbox-command-log",
                "unit-test-report",
                "integration-test-report",
                "android-lint-report",
                "android-apk-artifact",
                "roborazzi-report",
                "architecture-guard-report",
                "room-migration-report",
                "cloud-test-report",
                "contract-parity-report",
                "sql-migration-report",
                "github-ci-run",
                "secrets-scan-report",
                "backup-restore-report",
                "privacy-erasure-report",
                "plugin-installation-report",
                "screenshot-or-recording",
                "manual-device-note",
                "source-audit-note",
                "static-analysis-report"
              ]
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "privacy": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "sensitive",
              "flags"
            ],
            "properties": {
              "sensitive": {
                "type": "boolean"
              },
              "flags": {
                "type": "array",
                "items": {
                  "enum": [
                    "profile-scoped-data",
                    "user-content",
                    "credentials-or-tokens",
                    "ai-key",
                    "location-data",
                    "community-or-group-data",
                    "payment-adjacent-data",
                    "sensitive-files",
                    "cloud-transit",
                    "multi-profile-isolation"
                  ]
                },
                "uniqueItems": true
              }
            }
          },
          "migration": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "involved",
              "types",
              "notes"
            ],
            "properties": {
              "involved": {
                "type": "boolean"
              },
              "types": {
                "type": "array",
                "items": {
                  "enum": [
                    "room",
                    "cloud-sql",
                    "backup-format",
                    "datapack-format",
                    "plugin-package-format"
                  ]
                },
                "uniqueItems": true
              },
              "notes": {
                "type": "string"
              }
            }
          },
          "deviceTested": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "pendingUser",
              "label",
              "rule",
              "pendingEvidenceTypes"
            ],
            "properties": {
              "pendingUser": {
                "type": "boolean"
              },
              "label": {
                "anyOf": [
                  {
                    "const": "DEVICE_TESTED 待用户"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "rule": {
                "type": "string",
                "minLength": 1
              },
              "pendingEvidenceTypes": {
                "type": "array",
                "items": {
                  "enum": [
                    "devbox-command-log",
                    "unit-test-report",
                    "integration-test-report",
                    "android-lint-report",
                    "android-apk-artifact",
                    "roborazzi-report",
                    "architecture-guard-report",
                    "room-migration-report",
                    "cloud-test-report",
                    "contract-parity-report",
                    "sql-migration-report",
                    "github-ci-run",
                    "secrets-scan-report",
                    "backup-restore-report",
                    "privacy-erasure-report",
                    "plugin-installation-report",
                    "screenshot-or-recording",
                    "manual-device-note",
                    "source-audit-note",
                    "static-analysis-report"
                  ]
                },
                "uniqueItems": true
              }
            }
          },
          "maximumAutomaticVerificationLevel": {
            "enum": [
              "SOURCE_CONFIRMED",
              "MOCK_TESTED"
            ]
          }
        }
      }
    }
  }
}
