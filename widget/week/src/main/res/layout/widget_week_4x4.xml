<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/week_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_week_widget"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_wk_header"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="本周课表总览 · 第 8 教学周"
            android:textColor="@color/wk_widget_primary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_wk_sub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="★ 今日高亮"
            android:textColor="@color/wk_widget_accent"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_wk_day_1"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:singleLine="true"
            android:text="周一 │ 1-2数据结构 · 3-4概率论 · 5-6计网"
            android:textColor="@color/wk_widget_primary"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tv_wk_day_2"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:singleLine="true"
            android:text="周二 │ 1-2操作系统 · 5-6数据库 · 9-10智慧粮仓"
            android:textColor="@color/wk_widget_primary"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tv_wk_day_3"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:singleLine="true"
            android:text="周三 │ 3-4数据结构 · 5-6计算机网络"
            android:textColor="@color/wk_widget_primary"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tv_wk_day_4"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:singleLine="true"
            android:text="周四 │ 1-2概率论 · 3-4操作系统 · 7-8体育"
            android:textColor="@color/wk_widget_primary"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tv_wk_day_5"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:singleLine="true"
            android:text="周五 │ 1-2数据库 · 5-6数据结构实验"
            android:textColor="@color/wk_widget_primary"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tv_wk_day_6"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:singleLine="true"
            android:text="★周六 │ 1-2智慧粮仓 · 3-4数据结构 · 5-6操作系统"
            android:textColor="@color/wk_widget_accent"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_wk_day_7"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:singleLine="true"
            android:text="周日 │ 无排课（自由支配）"
            android:textColor="@color/wk_widget_secondary"
            android:textSize="11sp" />
    </LinearLayout>

</LinearLayout>
