<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/week_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_week_widget"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- 顶部第1层：周课表标题与今日高亮胶囊 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_wk_header"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:singleLine="true"
            android:text="本周课表 · 第 10 教学周"
            android:textColor="@color/wk_widget_primary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_wk_sub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_week_badge"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:singleLine="true"
            android:text="今日高亮"
            android:textColor="@color/wk_widget_accent"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 主体第2层：7 张分层行卡片（包含课程名与教室号） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="7dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_wk_day_1"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@drawable/bg_week_row"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:maxLines="2"
            android:paddingHorizontal="9dp"
            android:text="周一  1-2 数据结构 @5教5204 · 3-4 概率论 @6教6201"
            android:textColor="@color/wk_widget_primary"
            android:textSize="10.5sp" />

        <TextView
            android:id="@+id/tv_wk_day_2"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="3dp"
            android:layout_weight="1"
            android:background="@drawable/bg_week_row"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:maxLines="2"
            android:paddingHorizontal="9dp"
            android:text="周二  1-2 操作系统 @5教5103 · 5-6 数据库 @7教7201"
            android:textColor="@color/wk_widget_primary"
            android:textSize="10.5sp" />

        <TextView
            android:id="@+id/tv_wk_day_3"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="3dp"
            android:layout_weight="1"
            android:background="@drawable/bg_week_row"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:maxLines="2"
            android:paddingHorizontal="9dp"
            android:text="周三  3-4 数据结构 @5教5204 · 5-6 计算机网络 @8教8301"
            android:textColor="@color/wk_widget_primary"
            android:textSize="10.5sp" />

        <TextView
            android:id="@+id/tv_wk_day_4"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="3dp"
            android:layout_weight="1"
            android:background="@drawable/bg_week_row"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:maxLines="2"
            android:paddingHorizontal="9dp"
            android:text="周四  1-2 概率论 @6教6201 · 3-4 操作系统 @5教5103"
            android:textColor="@color/wk_widget_primary"
            android:textSize="10.5sp" />

        <TextView
            android:id="@+id/tv_wk_day_5"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="3dp"
            android:layout_weight="1"
            android:background="@drawable/bg_week_row"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:maxLines="2"
            android:paddingHorizontal="9dp"
            android:text="周五  1-2 数据库 @7教7201 · 5-6 实验 @工业中心"
            android:textColor="@color/wk_widget_primary"
            android:textSize="10.5sp" />

        <TextView
            android:id="@+id/tv_wk_day_6"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="3dp"
            android:layout_weight="1"
            android:background="@drawable/bg_week_row_today"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:maxLines="2"
            android:paddingHorizontal="9dp"
            android:text="周六  无课"
            android:textColor="@color/wk_widget_accent"
            android:textSize="10.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_wk_day_7"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="3dp"
            android:layout_weight="1"
            android:background="@drawable/bg_week_row"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:maxLines="2"
            android:paddingHorizontal="9dp"
            android:text="周日  无课"
            android:textColor="@color/wk_widget_secondary"
            android:textSize="10.5sp" />
    </LinearLayout>

</LinearLayout>
