<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/parcel_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_today_widget"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- 顶部栏：标题 + 待取快递胶囊 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_parcel_header"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="📦 校园快递取件码"
            android:textColor="@color/today_widget_primary"
            android:textSize="12.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_parcel_count_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_today_badge"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:singleLine="true"
            android:text="待取 2 件"
            android:textColor="@color/today_widget_accent"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 主体：左侧首要取件码大卡 + 右侧其余待取包裹列 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="7dp"
        android:layout_weight="1"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/layout_parcel_primary"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.15"
            android:background="@drawable/bg_today_highlight"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp"
            android:paddingVertical="8dp">

            <TextView
                android:layout_width="3.5dp"
                android:layout_height="match_parent"
                android:background="@drawable/bg_today_accent_bar" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_parcel_station"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:text="📍 莲花街北苑菜鸟驿站"
                    android:textColor="@color/today_widget_secondary"
                    android:textSize="10.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_parcel_code_main"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:ellipsize="end"
                    android:fontFamily="monospace"
                    android:singleLine="true"
                    android:text="3-2-1048"
                    android:textColor="@color/today_widget_accent"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_parcel_meta_main"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:text="顺丰速运 · 点击打开取件"
                    android:textColor="@color/today_widget_primary"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layout_parcel_secondary"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:layout_weight="1.02"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@drawable/bg_today_sub_slot"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:paddingHorizontal="9dp"
                android:paddingVertical="4dp">

                <TextView
                    android:id="@+id/tv_parcel_sub_1_code"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="monospace"
                    android:singleLine="true"
                    android:text="5-1-2089"
                    android:textColor="@color/today_widget_accent"
                    android:textSize="12.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_parcel_sub_1_desc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1.5dp"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:text="中通快递 · 北苑驿站"
                    android:textColor="@color/today_widget_primary"
                    android:textSize="10.5sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_today_sub_slot"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:paddingHorizontal="9dp"
                android:paddingVertical="4dp">

                <TextView
                    android:id="@+id/tv_parcel_sub_2_code"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:text="快递中心 ›"
                    android:textColor="@color/today_widget_primary"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_parcel_sub_2_desc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1.5dp"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:text="同步小米快递 / 短信识码"
                    android:textColor="@color/today_widget_secondary"
                    android:textSize="10.5sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
