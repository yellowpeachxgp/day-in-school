<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/today_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_today_widget"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- 顶部第1层：日期教学周标题与右侧胶囊倒计时 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_today_header"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:singleLine="true"
            android:text="11月02日 周一 · 第 10 教学周"
            android:textColor="@color/today_widget_primary"
            android:textSize="12.5sp"
            android:textStyle="bold" />

        <Chronometer
            android:id="@+id/chronometer_today"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_today_badge"
            android:countDown="true"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:textColor="@color/today_widget_accent"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 主体第2层：左侧高亮焦点主卡 + 右侧双层双行完整教室子卡 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="7dp"
        android:layout_weight="1"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/layout_focus_card"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.15"
            android:background="@drawable/bg_today_highlight"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp"
            android:paddingVertical="8dp">

            <TextView
                android:layout_width="3.5dp"
                android:layout_height="match_parent"
                android:background="@drawable/bg_today_accent_bar" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tv_focus_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_today_badge"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="1.5dp"
                        android:singleLine="true"
                        android:text="下一节课"
                        android:textColor="@color/today_widget_accent"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_focus_time"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:singleLine="true"
                        android:text="10:10–11:50"
                        android:textColor="@color/today_widget_secondary"
                        android:textSize="10.5sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_focus_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:text="数据结构与算法"
                    android:textColor="@color/today_widget_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <!-- 独立一行完整显示教室，绝不与时间挤在同一单行被截断 -->
                <TextView
                    android:id="@+id/tv_focus_meta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:text="5号教学楼 5204 · 3-4节"
                    android:textColor="@color/today_widget_accent"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layout_subsequent"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:layout_weight="1.02"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@drawable/bg_today_sub_slot"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:paddingHorizontal="9dp"
                android:paddingVertical="4dp">

                <TextView
                    android:id="@+id/tv_sub_1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:text="14:30 操作系统原理"
                    android:textColor="@color/today_widget_primary"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_sub_1_room"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1.5dp"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:text="4号教学楼 4102 · 5-6节"
                    android:textColor="@color/today_widget_accent"
                    android:textSize="10.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_today_sub_slot"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:paddingHorizontal="9dp"
                android:paddingVertical="4dp">

                <TextView
                    android:id="@+id/tv_sub_2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:text="19:00 形势与政策"
                    android:textColor="@color/today_widget_primary"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_sub_2_room"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1.5dp"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:text="钟楼报告厅 101 · 9-10节"
                    android:textColor="@color/today_widget_secondary"
                    android:textSize="10.5sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
