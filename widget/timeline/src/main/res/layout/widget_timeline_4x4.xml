<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/timeline_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_timeline_widget"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_tl_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="今日时间轴 · 第 8 教学周"
            android:textColor="@color/tl_widget_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_tl_now_indicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="● 实时同步"
            android:textColor="@color/tl_widget_accent"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:background="@drawable/bg_timeline_slot"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:padding="10dp">

        <TextView
            android:id="@+id/tv_tl_slot_1"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:singleLine="true"
            android:text="08:00–09:40 │ 智慧粮仓与物联网导论 · 1教1104 [已结束]"
            android:textColor="@color/tl_widget_secondary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tv_tl_slot_2"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:singleLine="true"
            android:text="10:10–11:50 │ ● 数据结构与算法 · 2教2204 [下一节]"
            android:textColor="@color/tl_widget_accent"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_tl_slot_3"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:singleLine="true"
            android:text="14:30–16:10 │ 操作系统原理 · 4教4102 [未开始]"
            android:textColor="@color/tl_widget_primary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tv_tl_slot_4"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:singleLine="true"
            android:text="19:00–20:40 │ 形势与政策 · 钟楼报告厅101 [未开始]"
            android:textColor="@color/tl_widget_primary"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_tl_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:singleLine="true"
        android:text="点击任意条目进入 App 比例时间轴与教室导航"
        android:textColor="@color/tl_widget_secondary"
        android:textSize="11sp" />

</LinearLayout>
