<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <queries>
        <package android:name="com.miui.personalassistant" />
        <package android:name="com.xiaomi.account" />
        <package android:name="com.miui.home" />
        <package android:name="com.xiaomi.misettings" />
        <package android:name="com.xiaomi.market" />
        <package android:name="com.tencent.mobileqq" />
        <package android:name="com.tencent.tim" />
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="mqqapi" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <application
        android:name=".HautCampusApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="false"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <!-- 小米/HyperOS 系统共享库：启用后才能通过 Class.forName("miui.util.CoderUtils") 调用小米智能助理原生加解密；非小米机型 required=false 自动跳过 -->
        <uses-library
            android:name="com.miui.system"
            android:required="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="dayinschool"
                    android:host="auth"
                    android:pathPrefix="/callback" />
            </intent-filter>
        </activity>

        <!-- 默认工大深蓝自适应桌面图标别名（与候选二次元图标互斥切换，绝不在桌面产生双图标） -->
        <activity-alias
            android:name=".MainActivityDefaultIconAlias"
            android:targetActivity=".MainActivity"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- 可选桌面候选图标别名（默认关闭，用户可在「设置 → 外观、隐私与数据」中互斥切换） -->
        <activity-alias
            android:name=".MainActivityAnimeIconAlias"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_anime"
            android:roundIcon="@mipmap/ic_launcher_anime_round"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- 在线拉取 GitHub Release APK 覆盖安装 FileProvider -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- 1. 下一节课 2x2 小组件 -->
        <receiver
            android:name="cn.edu.haut.campus.widget.nextclass.NextClassAppWidgetProvider"
            android:exported="true"
            android:label="下一节课 (2×2)">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.DATE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_next_class_info" />
        </receiver>

        <!-- 2. 今日课程 4x2 小组件 -->
        <receiver
            android:name="cn.edu.haut.campus.widget.today.TodayAppWidgetProvider"
            android:exported="true"
            android:label="今日课程 (4×2)">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.DATE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_today_info" />
        </receiver>

        <!-- 3. 今日日程 4x4 小组件 -->
        <receiver
            android:name="cn.edu.haut.campus.widget.timeline.TimelineAppWidgetProvider"
            android:exported="true"
            android:label="今日日程 (4×4)">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.DATE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_timeline_info" />
        </receiver>

        <!-- 4. 本周课表 4x4 小组件 -->
        <receiver
            android:name="cn.edu.haut.campus.widget.week.WeekAppWidgetProvider"
            android:exported="true"
            android:label="本周课表 (4×4)">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.DATE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_week_info" />
        </receiver>

        <!-- 5. 取件码 4x2 小组件 -->
        <receiver
            android:name="cn.edu.haut.campus.widget.today.ParcelAppWidgetProvider"
            android:exported="true"
            android:label="取件码 (4×2)">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.DATE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_parcel_pickup_info" />
        </receiver>

        <!-- 5. 课程与考试智能提醒到期广播接收器 -->
        <receiver
            android:name="cn.edu.haut.campus.core.reminder.ReminderFireReceiver"
            android:exported="false" />

        <!-- 6. 通知栏「稍后提醒 / 忽略」动作广播接收器 -->
        <receiver
            android:name="cn.edu.haut.campus.core.reminder.SnoozeActionReceiver"
            android:exported="false" />

        <!-- 7. 系统启动 / 覆盖升级 / 时间时区 / 精确闹钟权限变更对账接收器 -->
        <receiver
            android:name="cn.edu.haut.campus.core.reminder.ReminderSystemReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- 8. 自习专注计时独立到期与测试广播接收器 -->
        <receiver
            android:name="cn.edu.haut.campus.core.reminder.focus.FocusAlarmReceiver"
            android:exported="false" />

        <!-- 9. 自习专注计时独立重启/时间变更恢复接收器 -->
        <receiver
            android:name="cn.edu.haut.campus.core.reminder.focus.FocusRestoreReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- 10. 图书馆本地三段式抢座闹钟广播接收器 (T-30m / T-5m / T) -->
        <receiver
            android:name="cn.edu.haut.campus.core.database.LibrarySeatAlarmReceiver"
            android:exported="false" />

        <!-- 11. 图书馆抢座计划开机/升级/权限恢复接收器 -->
        <receiver
            android:name="cn.edu.haut.campus.core.database.LibrarySeatRestoreReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
